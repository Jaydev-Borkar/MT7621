#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "invendis,silbo-RG04", "mediatek,mt7621-soc";
	model = "Invendis Silbo-RG04";

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&sdhci {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		broken-flash-reset;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
			};

			firmware: partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0x1fb0000>;
			};
		};
	};
};

&pcie {
	status = "okay";
};

&pcie1 {
	mt76@0,0 {
        mediatek,mtd-eeprom = <&factory 0x0000>;
        mtd-mac-address = <&factory 0x0000>;
        ieee80211-freq-limit = <2400000 2500000>;

		led {
			led-sources = <2>;
		};
	};
};

&pcie2 {
	mt76@1,0 {
        mediatek,mtd-eeprom = <&factory 0x8000>;
        mtd-mac-address = <&factory 0x8000>;
        ieee80211-freq-limit = <5000000 6000000>;
	};
};

&gmac0 {
	mtd-mac-address = <&factory 0xe000>;
};

&gsw {
	mediatek,portmap = "lwwww";
	status = "okay";
};

&hnat {
	mtketh-wan = "eth0.2";
	mtketh-ppd = "eth0.1";
	mtketh-lan = "eth0";
	mtketh-max-gmac = <1>;
	/delete-property/ mtkdsa-wan-port;
};

&switch0 {
	status = "disabled";
};

&state_default {
	gpio {
		groups = "wdt", "uart2";
		function = "gpio";
	};
};

&uartlite2 {																																									
	status = "okay";
};

&xhci {
	status = "okay";
};

&i2c {
	status = "okay";
	compatible = "mediatek,mt7621-i2c", "i2c-gpio";
	
	i2c-gpio,delay-us = <10>;
	
	pca9535@23 {
	compatible = "nxp,pca9535";
	reg = <0x23>; 
	gpio-controller;
	};
};
