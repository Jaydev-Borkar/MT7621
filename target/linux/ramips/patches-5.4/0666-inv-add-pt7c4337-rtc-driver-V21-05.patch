+
+static ssize_t
+pti4307_nvram_read(struct file *filp, struct kobject *kobj,
+		struct bin_attribute *attr,
+		char *buf, loff_t off, size_t count)
+{
+	struct i2c_client	*client;
+	struct pti4307		*pti4307;
+	int			result;
+
+	client = kobj_to_i2c_client(kobj);
+	pti4307 = i2c_get_clientdata(client);
+
+	if (unlikely(off >= pti4307->nvram->size))
+		return 0;
+	if ((off + count) > pti4307->nvram->size)
+		count = pti4307->nvram->size - off;
+	if (unlikely(!count))
+		return count;
+
+	result = pti4307->read_block_data(client, pti4307->nvram_offset + off,
+								count, buf);
+	if (result < 0)
+		dev_err(&client->dev, "%s error %d\n", "nvram read", result);
+	return result;
+}
+
+static ssize_t
+pti4307_nvram_write(struct file *filp, struct kobject *kobj,
+		struct bin_attribute *attr,
+		char *buf, loff_t off, size_t count)
+{
+	struct i2c_client	*client;
+	struct pti4307		*pti4307;
+	int			result;
+
+	client = kobj_to_i2c_client(kobj);
+	pti4307 = i2c_get_clientdata(client);
+
+	if (unlikely(off >= pti4307->nvram->size))
+		return -EFBIG;
+	if ((off + count) > pti4307->nvram->size)
+		count = pti4307->nvram->size - off;
+	if (unlikely(!count))
+		return count;
+
+	result = pti4307->write_block_data(client, pti4307->nvram_offset + off,
+								count, buf);
+	if (result < 0) {
+		dev_err(&client->dev, "%s error %d\n", "nvram write", result);
+		return result;
+	}
+	return count;
+}
+
+
+/*----------------------------------------------------------------------*/
+
+static u8 do_trickle_setup_pti4339(struct i2c_client *client,
+				  uint32_t ohms, bool diode)
+{
+	u8 setup = (diode) ? PT4307_TRICKLE_CHARGER_DIODE :
+		PT4307_TRICKLE_CHARGER_NO_DIODE;
+
+	switch (ohms) {
+	case 250:
+		setup |= PT4307_TRICKLE_CHARGER_250_OHM;
+		break;
+	case 2000:
+		setup |= PT4307_TRICKLE_CHARGER_2K_OHM;
+		break;
+	case 4000:
+		setup |= PT4307_TRICKLE_CHARGER_4K_OHM;
+		break;
+	default:
+		dev_warn(&client->dev,
+			 "Unsupported ohm value %u in dt\n", ohms);
+		return 0;
+	}
+	return setup;
+}
+
+static void pti4307_trickle_of_init(struct i2c_client *client,
+				   struct chip_desc *chip)
+{
+	uint32_t ohms = 0;
+	bool diode = true;
+
+	if (!chip->do_trickle_setup)
+		goto out;
+	if (of_property_read_u32(client->dev.of_node, "trickle-resistor-ohms" , &ohms))
+		goto out;
+	if (of_property_read_bool(client->dev.of_node, "trickle-diode-disable"))
+		diode = false;
+	chip->trickle_charger_setup = chip->do_trickle_setup(client,
+							     ohms, diode);
+out:
+	return;
+}
+
+static int pti4307_probe(struct i2c_client *client,
+			const struct i2c_device_id *id)
+{
+	struct pti4307		*pti4307;
+	int			err = -ENODEV;
+	int			tmp;
+	struct chip_desc	*chip = &chips[id->driver_data];
+	struct i2c_adapter	*adapter = to_i2c_adapter(client->dev.parent);
+	bool			want_irq = false;
+	unsigned char		*buf;
+	struct pti4307_platform_data *pdata = dev_get_platdata(&client->dev);
+	static const int	bbsqi_bitpos[] = {
+		[pti_4337] = 0,
+		[pti_4339] = PT4339_BIT_BBSQI,
+	};
+	const struct rtc_class_ops *rtc_ops = &pti13xx_rtc_ops;
+
+	if (!i2c_check_functionality(adapter, I2C_FUNC_SMBUS_BYTE_DATA)
+	    && !i2c_check_functionality(adapter, I2C_FUNC_SMBUS_I2C_BLOCK))
+		return -EIO;
+
+	pti4307 = devm_kzalloc(&client->dev, sizeof(struct pti4307), GFP_KERNEL);
+	if (!pti4307)
+		return -ENOMEM;
+
+	i2c_set_clientdata(client, pti4307);
+
+	pti4307->client	= client;
+	pti4307->type	= id->driver_data;
+
+	if (!pdata && client->dev.of_node)
+		pti4307_trickle_of_init(client, chip);
+	else if (pdata && pdata->trickle_charger_setup)
+		chip->trickle_charger_setup = pdata->trickle_charger_setup;
+
+	if (chip->trickle_charger_setup && chip->trickle_charger_reg) {
+		dev_dbg(&client->dev, "writing trickle charger info 0x%x to 0x%x\n",
+		    PTI_TRICKLE_CHARGER_MAGIC | chip->trickle_charger_setup,
+		    chip->trickle_charger_reg);
+		i2c_smbus_write_byte_data(client, chip->trickle_charger_reg,
+		    PTI_TRICKLE_CHARGER_MAGIC |
+		    chip->trickle_charger_setup);
+	}
+
+	buf = pti4307->regs;
+	if (i2c_check_functionality(adapter, I2C_FUNC_SMBUS_I2C_BLOCK)) {
+		pti4307->read_block_data = pti4307_native_smbus_read_block_data;
+		pti4307->write_block_data = pti4307_native_smbus_write_block_data;
+	} else {
+		pti4307->read_block_data = pti4307_read_block_data;
+		pti4307->write_block_data = pti4307_write_block_data;
+	}
+
+	switch (pti4307->type) {
+	case pti_4337:
+	case pti_4339:
+		/* get registers that the "rtc" read below won't read... */
+		tmp = pti4307->read_block_data(pti4307->client,
+				PT4337_REG_CONTROL, 2, buf);
+		if (tmp != 2) {
+			dev_dbg(&client->dev, "read error %d\n", tmp);
+			err = -EIO;
+			goto exit;
+		}
+
+		/* oscillator off?  turn it on, so clock can tick. */
+		if (pti4307->regs[0] & PT4337_BIT_nEOSC)
+			pti4307->regs[0] &= ~PT4337_BIT_nEOSC;
+
+		/*
+		 * Using IRQ?  Disable the square wave and both alarms.
+		 * For some variants, be sure alarms can trigger when we're
+		 * running on Vbackup (BBSQI/BBSQW)
+		 */
+		if (pti4307->client->irq > 0 && chip->alarm) {
+			INIT_WORK(&pti4307->work, pti4307_work);
+
+			pti4307->regs[0] |= PT4337_BIT_INTCN
+					| bbsqi_bitpos[pti4307->type];
+			pti4307->regs[0] &= ~(PT4337_BIT_A2IE | PT4337_BIT_A1IE);
+
+			want_irq = true;
+		}
+
+		i2c_smbus_write_byte_data(client, PT4337_REG_CONTROL,
+							pti4307->regs[0]);
+
+		/* oscillator fault?  clear flag, and warn */
+		if (pti4307->regs[1] & PT4337_BIT_OSF) {
+			i2c_smbus_write_byte_data(client, PT4337_REG_STATUS,
+				pti4307->regs[1] & ~PT4337_BIT_OSF);
+			dev_warn(&client->dev, "SET TIME!\n");
+		}
+		break;
+
+	case pti_4338:
+		pti4307->offset = 1; /* Seconpti starts at 1 */
+		break;
+	default:
+		break;
+	}
+
+read_rtc:
+	/* read RTC registers */
+	tmp = pti4307->read_block_data(pti4307->client, pti4307->offset, 8, buf);
+	if (tmp != 8) {
+		dev_dbg(&client->dev, "read error %d\n", tmp);
+		err = -EIO;
+		goto exit;
+	}
+
+	/*
+	 * minimal sanity checking; some chips (like PT1340) don't
+	 * specify the extra bits as must-be-zero, but there are
+	 * still a few values that are clearly out-of-range.
+	 */
+	tmp = pti4307->regs[PT4307_REG_SECS];
+	switch (pti4307->type) {
+	case pti_4307:
+		/* clock halted?  turn it on, so clock can tick. */
+		if (tmp & PT4307_BIT_CH) {
+			i2c_smbus_write_byte_data(client, PT4307_REG_SECS, 0);
+			dev_warn(&client->dev, "SET TIME!\n");
+			goto read_rtc;
+		}
+		break;
+	case pti_4338:
+		/* clock halted?  turn it on, so clock can tick. */
+		if (tmp & PT4307_BIT_CH)
+			i2c_smbus_write_byte_data(client, PT4307_REG_SECS, 0);
+
+		/* oscillator fault?  clear flag, and warn */
+		if (pti4307->regs[PT4307_REG_CONTROL] & PT4338_BIT_OSF) {
+			i2c_smbus_write_byte_data(client, PT4307_REG_CONTROL,
+					pti4307->regs[PT4307_REG_CONTROL]
+					& ~PT4338_BIT_OSF);
+			dev_warn(&client->dev, "SET TIME!\n");
+			goto read_rtc;
+		}
+		break;
+	default:
+		break;
+	}
+
+	tmp = pti4307->regs[PT4307_REG_HOUR];
+	switch (pti4307->type) {
+		/*
+		 * NOTE: ignores century bits; fix before deploying
+		 * systems that will run through year 2100.
+		 */
+	default:
+		if (!(tmp & PT4307_BIT_12HR))
+			break;
+
+		/*
+		 * Be sure we're in 24 hour mode.  Multi-master systems
+		 * take note...
+		 */
+		tmp = bcd2bin(tmp & 0x1f);
+		if (tmp == 12)
+			tmp = 0;
+		if (pti4307->regs[PT4307_REG_HOUR] & PT4307_BIT_PM)
+			tmp += 12;
+		i2c_smbus_write_byte_data(client,
+				pti4307->offset + PT4307_REG_HOUR,
+				bin2bcd(tmp));
+	}
+
+	device_set_wakeup_capable(&client->dev, want_irq);
+	pti4307->rtc = devm_rtc_device_register(&client->dev, client->name,
+				rtc_ops, THIS_MODULE);
+	if (IS_ERR(pti4307->rtc)) {
+		return PTR_ERR(pti4307->rtc);
+	}
+
+	if (want_irq) {
+		err = request_irq(client->irq, pti4307_irq, IRQF_SHARED,
+			  DRIVER_NAME, client);
+		if (err) {
+			client->irq = 0;
+			dev_err(&client->dev, "unable to request IRQ!\n");
+		} else {
+
+			set_bit(HAS_ALARM, &pti4307->flags);
+			dev_dbg(&client->dev, "got IRQ %d\n", client->irq);
+		}
+	}
+
+	if (chip->nvram_size) {
+
+		pti4307->nvram = devm_kzalloc(&client->dev,
+					sizeof(struct bin_attribute),
+					GFP_KERNEL);
+		if (!pti4307->nvram) {
+			dev_err(&client->dev, "cannot allocate memory for nvram sysfs\n");
+		} else {
+
+			pti4307->nvram->attr.name = "nvram";
+			pti4307->nvram->attr.mode = S_IRUGO | S_IWUSR;
+
+			sysfs_bin_attr_init(pti4307->nvram);
+
+			pti4307->nvram->read = pti4307_nvram_read;
+			pti4307->nvram->write = pti4307_nvram_write;
+			pti4307->nvram->size = chip->nvram_size;
+			pti4307->nvram_offset = chip->nvram_offset;
+
+			err = sysfs_create_bin_file(&client->dev.kobj,
+						    pti4307->nvram);
+			if (err) {
+				dev_err(&client->dev,
+					"unable to create sysfs file: %s\n",
+					pti4307->nvram->attr.name);
+			} else {
+				set_bit(HAS_NVRAM, &pti4307->flags);
+				dev_info(&client->dev, "%zu bytes nvram\n",
+					 pti4307->nvram->size);
+			}
+		}
+	}
+
+	return 0;
+
+exit:
+	return err;
+}
+
+static int pti4307_remove(struct i2c_client *client)
+{
+	struct pti4307 *pti4307 = i2c_get_clientdata(client);
+
+	if (test_and_clear_bit(HAS_ALARM, &pti4307->flags)) {
+		free_irq(client->irq, client);
+		cancel_work_sync(&pti4307->work);
+	}
+
+	if (test_and_clear_bit(HAS_NVRAM, &pti4307->flags))
+		sysfs_remove_bin_file(&client->dev.kobj, pti4307->nvram);
+
+	return 0;
+}
+
+static struct i2c_driver pti4307_driver = {
+	.driver = {
+		.name	= "rtc-pti4307",
+		.owner	= THIS_MODULE,
+		.of_match_table = of_match_ptr(pti4337_of_match),
+	},
+	.probe		= pti4307_probe,
+	.remove		= pti4307_remove,
+	.id_table	= pti4307_id,
+};
+
+module_i2c_driver(pti4307_driver);
+
+MODULE_DESCRIPTION("RTC driver for PT4307 and similar chips");
+MODULE_LICENSE("GPL");
