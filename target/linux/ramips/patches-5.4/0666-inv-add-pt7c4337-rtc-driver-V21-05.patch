+/*
+ * rtc-pti4307.c - RTC driver for some mostly-compatible I2C chips.
+ *
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ */
+
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/slab.h>
+#include <linux/i2c.h>
+#include <linux/string.h>
+#include <linux/rtc.h>
+#include <linux/bcd.h>
+#include <linux/rtc/PT7C4307.h>
+
+#define DRIVER_NAME "rtc_pt7c4307"
+
+/*
+ * We can't determine type by probing, but if we expect pre-Linux code
+ * to have set the chip up as a clock (turning on the oscillator and
+ * setting the date and time), Linux can ignore the non-clock features.
+ * That's a natural job for a factory or repair bench.
+ */
+enum pti_type {
+	pti_4307,
+	pti_4337,
+	pti_4338,
+	pti_4339,
+	last_pti_type /* always last */
+};
+
+
+/* RTC registers don't differ much, except for the century flag */
+#define PT4307_REG_SECS		0x00	/* 00-59 */
+#	define PT4307_BIT_CH		0x80
+#define PT4307_REG_MIN		0x01	/* 00-59 */
+#define PT4307_REG_HOUR		0x02	/* 00-23, or 1-12{am,pm} */
+#	define PT4307_BIT_12HR		0x40	/* in REG_HOUR */
+#	define PT4307_BIT_PM		0x20	/* in REG_HOUR */
+#define PT4307_REG_WDAY		0x03	/* 01-07 */
+#define PT4307_REG_MDAY		0x04	/* 01-31 */
+#define PT4307_REG_MONTH	0x05	/* 01-12 */
+#	define PT4337_BIT_CENTURY	0x80	/* in REG_MONTH */
+#define PT4307_REG_YEAR		0x06	/* 00-99 */
+
+/*
+ * Other registers (control, status, alarms, trickle charge, NVRAM, etc)
+ * start at 7, and they differ a LOT. Only control and status matter for
+ * basic RTC date and time functionality; be careful using them.
+ */
+#define PT4307_REG_CONTROL	0x07		/* or pti4338 */
+#	define PT4307_BIT_OUT		0x80
+#	define PT4338_BIT_OSF		0x20
+#	define PT4307_BIT_SQWE		0x10
+#	define PT4307_BIT_RS1		0x02
+#	define PT4307_BIT_RS0		0x01
+#define PT4337_REG_CONTROL	0x0e
+#	define PT4337_BIT_nEOSC		0x80
+#	define PT4339_BIT_BBSQI		0x20
+#	define PT4337_BIT_RS2		0x10
+#	define PT4337_BIT_RS1		0x08
+#	define PT4337_BIT_INTCN		0x04
+#	define PT4337_BIT_A2IE		0x02
+#	define PT4337_BIT_A1IE		0x01
+#define PT4337_REG_STATUS	0x0f
+#	define PT4337_BIT_OSF		0x80
+#	define PT4337_BIT_A2I		0x02
+#	define PT4337_BIT_A1I		0x01
+#define PT4339_REG_ALARM1_SECS	0x07
+
+#define PTI_TRICKLE_CHARGER_MAGIC	0xa0
+
+struct pti4307 {
+	u8			offset; /* register's offset */
+	u8			regs[11];
+	u16			nvram_offset;
+	struct bin_attribute	*nvram;
+	enum pti_type		type;
+	unsigned long		flags;
+#define HAS_NVRAM	0		/* bit 0 == sysfs file active */
+#define HAS_ALARM	1		/* bit 1 == irq claimed */
+	struct i2c_client	*client;
+	struct rtc_device	*rtc;
+	struct work_struct	work;
+	s32 (*read_block_data)(const struct i2c_client *client, u8 command,
+			       u8 length, u8 *values);
+	s32 (*write_block_data)(const struct i2c_client *client, u8 command,
+				u8 length, const u8 *values);
+};
+
+struct chip_desc {
+	unsigned		alarm:1;
+	u16			nvram_offset;
+	u16			nvram_size;
+	u16			trickle_charger_reg;
+	u8			trickle_charger_setup;
+	u8			(*do_trickle_setup)(struct i2c_client *, uint32_t, bool);
+};
+
+static u8 do_trickle_setup_pti4339(struct i2c_client *,
+				  uint32_t ohms, bool diode);
+
+static struct chip_desc chips[last_pti_type] = {
+	[pti_4307] = {
+		.nvram_offset	= 8,
+		.nvram_size	= 56,
+	},
+	[pti_4337] = {
+		.alarm		= 1,
+	},
+	[pti_4338] = {
+		.nvram_offset	= 8,
+		.nvram_size	= 56,
+	},
+	[pti_4339] = {
+		.alarm		= 1,
+		.trickle_charger_reg = 0x10,
+		.do_trickle_setup = &do_trickle_setup_pti4339,
+	},
+	
+};
+
+static const struct i2c_device_id pti4307_id[] = {
+	{ "pti4307", pti_4307 },
+	{ "pti4337", pti_4337 },
+	{ "pti4338", pti_4338 },
+	{ "pti4339", pti_4339 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, pti4307_id);
+ 
+ 
+//------------------------------------------------------------------
+//Added of_device_id for compatible in dts. 
+//The compatible name should be similar to device id - B.Sourab
+
+#ifdef CONFIG_OF
+static const struct of_device_id pti4337_of_match[] = {
+	{
+		.compatible = "pericom,pti4337",
+	},
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ds1307_of_match);
+#endif
+//--------------------------------------------------------------------
+
+/*----------------------------------------------------------------------*/
+
+#define BLOCK_DATA_MAX_TRIES 10
+
+static s32 pti4307_read_block_data_once(const struct i2c_client *client,
+				       u8 command, u8 length, u8 *values)
+{
+	s32 i, data;
+
+	for (i = 0; i < length; i++) {
+		data = i2c_smbus_read_byte_data(client, command + i);
+		if (data < 0)
+			return data;
+		values[i] = data;
+	}
+	return i;
+}
+
+static s32 pti4307_read_block_data(const struct i2c_client *client, u8 command,
+				  u8 length, u8 *values)
+{
+	u8 oldvalues[255];
+	s32 ret;
+	int tries = 0;
+
+	dev_dbg(&client->dev, "pti4307_read_block_data (length=%d)\n", length);
+	ret = pti4307_read_block_data_once(client, command, length, values);
+	if (ret < 0)
+		return ret;
+	do {
+		if (++tries > BLOCK_DATA_MAX_TRIES) {
+			dev_err(&client->dev,
+				"pti4307_read_block_data failed\n");
+			return -EIO;
+		}
+		memcpy(oldvalues, values, length);
+		ret = pti4307_read_block_data_once(client, command, length,
+						  values);
+		if (ret < 0)
+			return ret;
+	} while (memcmp(oldvalues, values, length));
+	return length;
+}
+
+static s32 pti4307_write_block_data(const struct i2c_client *client, u8 command,
+				   u8 length, const u8 *values)
+{
+	u8 currvalues[255];
+	int tries = 0;
+
+	dev_dbg(&client->dev, "pti4307_write_block_data (length=%d)\n", length);
+	do {
+		s32 i, ret;
+
+		if (++tries > BLOCK_DATA_MAX_TRIES) {
+			dev_err(&client->dev,
+				"pti4307_write_block_data failed\n");
+			return -EIO;
+		}
+		for (i = 0; i < length; i++) {
+			ret = i2c_smbus_write_byte_data(client, command + i,
+							values[i]);
+			if (ret < 0)
+				return ret;
+		}
+		ret = pti4307_read_block_data_once(client, command, length,
+						  currvalues);
+		if (ret < 0)
+			return ret;
+	} while (memcmp(currvalues, values, length));
+	return length;
+}
+
+/*----------------------------------------------------------------------*/
+
+/* These RTC devices are not designed to be connected to a SMbus adapter.
+   SMbus limits block operations length to 32 bytes, whereas it's not
+   limited on I2C buses. As a result, accesses may exceed 32 bytes;
+   in that case, split them into smaller blocks */
+
+static s32 pti4307_native_smbus_write_block_data(const struct i2c_client *client,
+				u8 command, u8 length, const u8 *values)
+{
+	u8 suboffset = 0;
+
+	if (length <= I2C_SMBUS_BLOCK_MAX)
+		return i2c_smbus_write_i2c_block_data(client,
+					command, length, values);
+
+	while (suboffset < length) {
+		s32 retval = i2c_smbus_write_i2c_block_data(client,
+				command + suboffset,
+				min(I2C_SMBUS_BLOCK_MAX, length - suboffset),
+				values + suboffset);
+		if (retval < 0)
+			return retval;
+
+		suboffset += I2C_SMBUS_BLOCK_MAX;
+	}
+	return length;
+}
+
+static s32 pti4307_native_smbus_read_block_data(const struct i2c_client *client,
+				u8 command, u8 length, u8 *values)
+{
+	u8 suboffset = 0;
+
+	if (length <= I2C_SMBUS_BLOCK_MAX)
+		return i2c_smbus_read_i2c_block_data(client,
+					command, length, values);
+
+	while (suboffset < length) {
+		s32 retval = i2c_smbus_read_i2c_block_data(client,
+				command + suboffset,
+				min(I2C_SMBUS_BLOCK_MAX, length - suboffset),
+				values + suboffset);
+		if (retval < 0)
+			return retval;
+
+		suboffset += I2C_SMBUS_BLOCK_MAX;
+	}
+	return length;
+}
+
+/*----------------------------------------------------------------------*/
+
+/*
+ * The IRQ logic includes a "real" handler running in IRQ context just
+ * long enough to schedule this workqueue entry.   We need a task context
+ * to talk to the RTC, since I2C I/O calls require that; and disable the
+ * IRQ until we clear its status on the chip, so that this handler can
+ * work with any type of triggering (not just falling edge).
+ *
+ * The pti4337 and pti4339 both have two alarms, but we only use the first
+ * one (with a "seconpti" field).  For pti4337 we expect nINTA is our alarm
+ * signal; pti4339 chips have only one alarm signal.
+ */
+static void pti4307_work(struct work_struct *work)
+{
+	struct pti4307		*pti4307;
+	struct i2c_client	*client;
+	struct mutex		*lock;
+	int			stat, control;
+
+	pti4307 = container_of(work, struct pti4307, work);
+	client = pti4307->client;
+	lock = &pti4307->rtc->ops_lock;
+
+	mutex_lock(lock);
+	stat = i2c_smbus_read_byte_data(client, PT4337_REG_STATUS);
+	if (stat < 0)
+		goto out;
+
+	if (stat & PT4337_BIT_A1I) {
+		stat &= ~PT4337_BIT_A1I;
+		i2c_smbus_write_byte_data(client, PT4337_REG_STATUS, stat);
+
+		control = i2c_smbus_read_byte_data(client, PT4337_REG_CONTROL);
+		if (control < 0)
+			goto out;
+
+		control &= ~PT4337_BIT_A1IE;
+		i2c_smbus_write_byte_data(client, PT4337_REG_CONTROL, control);
+
+		rtc_update_irq(pti4307->rtc, 1, RTC_AF | RTC_IRQF);
+	}
+
+out:
+	if (test_bit(HAS_ALARM, &pti4307->flags))
+		enable_irq(client->irq);
+	mutex_unlock(lock);
+}
+
+static irqreturn_t pti4307_irq(int irq, void *dev_id)
+{
+	struct i2c_client	*client = dev_id;
+	struct pti4307		*pti4307 = i2c_get_clientdata(client);
+
+	disable_irq_nosync(irq);
+	schedule_work(&pti4307->work);
+	return IRQ_HANDLED;
+}
+
+/*----------------------------------------------------------------------*/
+
+static int pti4307_get_time(struct device *dev, struct rtc_time *t)
+{
+	struct pti4307	*pti4307 = dev_get_drvdata(dev);
+	int		tmp;
+
+	/* read the RTC date and time registers all at once */
+	tmp = pti4307->read_block_data(pti4307->client,
+		pti4307->offset, 7, pti4307->regs);
+	if (tmp != 7) {
+		dev_err(dev, "%s error %d\n", "read", tmp);
+		return -EIO;
+	}
+
+	dev_dbg(dev, "%s: %7ph\n", "read", pti4307->regs);
+
+	t->tm_sec = bcd2bin(pti4307->regs[PT4307_REG_SECS] & 0x7f);
+	t->tm_min = bcd2bin(pti4307->regs[PT4307_REG_MIN] & 0x7f);
+	tmp = pti4307->regs[PT4307_REG_HOUR] & 0x3f;
+	t->tm_hour = bcd2bin(tmp);
+	t->tm_wday = bcd2bin(pti4307->regs[PT4307_REG_WDAY] & 0x07) - 1;
+	t->tm_mday = bcd2bin(pti4307->regs[PT4307_REG_MDAY] & 0x3f);
+	tmp = pti4307->regs[PT4307_REG_MONTH] & 0x1f;
+	t->tm_mon = bcd2bin(tmp) - 1;
+
+	/* assume 20YY not 19YY, and ignore PT4337_BIT_CENTURY */
+	t->tm_year = bcd2bin(pti4307->regs[PT4307_REG_YEAR]) + 100;
+
+	dev_dbg(dev, "%s secs=%d, mins=%d, "
+		"hours=%d, mday=%d, mon=%d, year=%d, wday=%d\n",
+		"read", t->tm_sec, t->tm_min,
+		t->tm_hour, t->tm_mday,
+		t->tm_mon, t->tm_year, t->tm_wday);
+
+	/* initial clock setting can be undefined */
+	return rtc_valid_tm(t);
+}
+
+static int pti4307_set_time(struct device *dev, struct rtc_time *t)
+{
+	struct pti4307	*pti4307 = dev_get_drvdata(dev);
+	int		result;
+	int		tmp;
+	u8		*buf = pti4307->regs;
+
+	dev_dbg(dev, "%s secs=%d, mins=%d, "
+		"hours=%d, mday=%d, mon=%d, year=%d, wday=%d\n",
+		"write", t->tm_sec, t->tm_min,
+		t->tm_hour, t->tm_mday,
+		t->tm_mon, t->tm_year, t->tm_wday);
+
+	buf[PT4307_REG_SECS] = bin2bcd(t->tm_sec);
+	buf[PT4307_REG_MIN] = bin2bcd(t->tm_min);
+	buf[PT4307_REG_HOUR] = bin2bcd(t->tm_hour);
+	buf[PT4307_REG_WDAY] = bin2bcd(t->tm_wday + 1);
+	buf[PT4307_REG_MDAY] = bin2bcd(t->tm_mday);
+	buf[PT4307_REG_MONTH] = bin2bcd(t->tm_mon + 1);
+
+	/* assume 20YY not 19YY */
+	tmp = t->tm_year - 100;
+	buf[PT4307_REG_YEAR] = bin2bcd(tmp);
+
+	switch (pti4307->type) {
+	case pti_4337:
+	case pti_4339:
+		buf[PT4307_REG_MONTH] |= PT4337_BIT_CENTURY;
+		break;
+	default:
+		break;
+	}
+
+	dev_dbg(dev, "%s: %7ph\n", "write", buf);
+
+	result = pti4307->write_block_data(pti4307->client,
+		pti4307->offset, 7, buf);
+	if (result < 0) {
+		dev_err(dev, "%s error %d\n", "write", result);
+		return result;
+	}
+	return 0;
+}
+
+static int pti4337_read_alarm(struct device *dev, struct rtc_wkalrm *t)
+{
+	struct i2c_client       *client = to_i2c_client(dev);
+	struct pti4307		*pti4307 = i2c_get_clientdata(client);
+	int			ret;
+
+	if (!test_bit(HAS_ALARM, &pti4307->flags))
+		return -EINVAL;
+
+	/* read all ALARM1, ALARM2, and status registers at once */
+	ret = pti4307->read_block_data(client,
+			PT4339_REG_ALARM1_SECS, 9, pti4307->regs);
+	if (ret != 9) {
+		dev_err(dev, "%s error %d\n", "alarm read", ret);
+		return -EIO;
+	}
+
+	dev_dbg(dev, "%s: %02x %02x %02x %02x, %02x %02x %02x, %02x %02x\n",
+			"alarm read",
+			pti4307->regs[0], pti4307->regs[1],
+			pti4307->regs[2], pti4307->regs[3],
+			pti4307->regs[4], pti4307->regs[5],
+			pti4307->regs[6], pti4307->regs[7],
+			pti4307->regs[8]);
+
+	/*
+	 * report alarm time (ALARM1); assume 24 hour and day-of-month modes,
+	 * and that all four fielpti are checked matches
+	 */
+	t->time.tm_sec = bcd2bin(pti4307->regs[0] & 0x7f);
+	t->time.tm_min = bcd2bin(pti4307->regs[1] & 0x7f);
+	t->time.tm_hour = bcd2bin(pti4307->regs[2] & 0x3f);
+	t->time.tm_mday = bcd2bin(pti4307->regs[3] & 0x3f);
+	t->time.tm_mon = -1;
+	t->time.tm_year = -1;
+	t->time.tm_wday = -1;
+	t->time.tm_yday = -1;
+	t->time.tm_isdst = -1;
+
+	/* ... and status */
+	t->enabled = !!(pti4307->regs[7] & PT4337_BIT_A1IE);
+	t->pending = !!(pti4307->regs[8] & PT4337_BIT_A1I);
+
+	dev_dbg(dev, "%s secs=%d, mins=%d, "
+		"hours=%d, mday=%d, enabled=%d, pending=%d\n",
+		"alarm read", t->time.tm_sec, t->time.tm_min,
+		t->time.tm_hour, t->time.tm_mday,
+		t->enabled, t->pending);
+
+	return 0;
+}
+
+static int pti4337_set_alarm(struct device *dev, struct rtc_wkalrm *t)
+{
+	struct i2c_client	*client = to_i2c_client(dev);
+	struct pti4307		*pti4307 = i2c_get_clientdata(client);
+	unsigned char		*buf = pti4307->regs;
+	u8			control, status;
+	int			ret;
+
+	if (!test_bit(HAS_ALARM, &pti4307->flags))
+		return -EINVAL;
+
+	dev_dbg(dev, "%s secs=%d, mins=%d, "
+		"hours=%d, mday=%d, enabled=%d, pending=%d\n",
+		"alarm set", t->time.tm_sec, t->time.tm_min,
+		t->time.tm_hour, t->time.tm_mday,
+		t->enabled, t->pending);
+
+	/* read current status of both alarms and the chip */
+	ret = pti4307->read_block_data(client,
+			PT4339_REG_ALARM1_SECS, 9, buf);
+	if (ret != 9) {
+		dev_err(dev, "%s error %d\n", "alarm write", ret);
+		return -EIO;
+	}
+	control = pti4307->regs[7];
+	status = pti4307->regs[8];
+
+	dev_dbg(dev, "%s: %02x %02x %02x %02x, %02x %02x %02x, %02x %02x\n",
+			"alarm set (old status)",
+			pti4307->regs[0], pti4307->regs[1],
+			pti4307->regs[2], pti4307->regs[3],
+			pti4307->regs[4], pti4307->regs[5],
+			pti4307->regs[6], control, status);
+
+	/* set ALARM1, using 24 hour and day-of-month modes */
+	buf[0] = bin2bcd(t->time.tm_sec);
+	buf[1] = bin2bcd(t->time.tm_min);
+	buf[2] = bin2bcd(t->time.tm_hour);
+	buf[3] = bin2bcd(t->time.tm_mday);
+
+	/* set ALARM2 to non-garbage */
+	buf[4] = 0;
+	buf[5] = 0;
+	buf[6] = 0;
+
+	/* optionally enable ALARM1 */
+	buf[7] = control & ~(PT4337_BIT_A1IE | PT4337_BIT_A2IE);
+	if (t->enabled) {
+		dev_dbg(dev, "alarm IRQ armed\n");
+		buf[7] |= PT4337_BIT_A1IE;	/* only ALARM1 is used */
+	}
+	buf[8] = status & ~(PT4337_BIT_A1I | PT4337_BIT_A2I);
+
+	ret = pti4307->write_block_data(client,
+			PT4339_REG_ALARM1_SECS, 9, buf);
+	if (ret < 0) {
+		dev_err(dev, "can't set alarm time\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static int pti4307_alarm_irq_enable(struct device *dev, unsigned int enabled)
+{
+	struct i2c_client	*client = to_i2c_client(dev);
+	struct pti4307		*pti4307 = i2c_get_clientdata(client);
+	int			ret;
+
+	if (!test_bit(HAS_ALARM, &pti4307->flags))
+		return -ENOTTY;
+
+	ret = i2c_smbus_read_byte_data(client, PT4337_REG_CONTROL);
+	if (ret < 0)
+		return ret;
+
+	if (enabled)
+		ret |= PT4337_BIT_A1IE;
+	else
+		ret &= ~PT4337_BIT_A1IE;
+
+	ret = i2c_smbus_write_byte_data(client, PT4337_REG_CONTROL, ret);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+static const struct rtc_class_ops pti13xx_rtc_ops = {
+	.read_time	= pti4307_get_time,
+	.set_time	= pti4307_set_time,
+	.read_alarm	= pti4337_read_alarm,
+	.set_alarm	= pti4337_set_alarm,
+	.alarm_irq_enable = pti4307_alarm_irq_enable,
+};
+
