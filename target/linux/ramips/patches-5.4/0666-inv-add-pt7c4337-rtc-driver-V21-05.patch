+#define PT4307_TRICKLE_CHARGER_2K_OHM	0x02
+#define PT4307_TRICKLE_CHARGER_4K_OHM	0x03
+#define PT4307_TRICKLE_CHARGER_NO_DIODE	0x04
+#define PT4307_TRICKLE_CHARGER_DIODE	0x08
