
config globals 'globals'
	option enabled '1'
	option mmx_mask '0x3F00'
	option rtmon_interval '5'

config rule 'default_rule_v6'
	option dest_ip '::/0'
	option use_policy 'failover_v6'
	option family 'ipv6'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option use_policy 'failover_v4'
	option family 'ipv4'

config member 'cwan1sim1_member'
	option interface 'CWAN1_0'
	option metric '8'

config member 'cwan1sim2_member'
	option interface 'CWAN1_1'
	option metric '9'

config policy 'failover_v4'
	list use_member 'ewan5_member'
	list use_member 'cwan1sim1_member'
	list use_member 'cwan1sim2_member'
	option last_resort 'default'

config interface 'EWAN5'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '8.8.4.4'
	option family 'ipv4'
	option reliability '1'
	option count '1'
	option timeout '2'
	option down '3'
	option up '3'

config member 'ewan5_member'
	option interface 'EWAN5'
	option metric '5'

config interface 'CWAN1_0'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '8.8.4.4'
	option family 'ipv4'
	option reliability '1'
	option count '1'
	option timeout '2'
	option down '3'
	option up '3'

config interface 'CWAN1_1'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '8.8.4.4'
	option family 'ipv4'
	option reliability '1'
	option count '1'
	option timeout '2'
	option down '3'
	option up '3'
