
config redirect 'EWAN1'
	option interface 'EWAN1'
	option ifname 'eth0.5'
	option type 'WAN'
	option protocol 'dhcpclient'
	option dhcpgateway '10.1.1.1'
	option enable_zoneforward '1'

config redirect 'SW_LAN'
	option interface 'SW_LAN'
	option ifname 'eth0.1'
	option type 'LAN'
	option staticgateway '192.168.10.3'
	list ServerStaticDnsServer '8.8.8.8'
	option ServerDHCPlimit '100'
	option leasetime '12'
	option enable_zoneforward '1'
	option internetoverinterface '1'
	option protocol_lan 'static_lan'
	option ServerDHCPrange '70'
	option staticIP '192.168.10.1'
	option enable_dns '1'
	option enable_relay '0'
	option enable_dhcpserver '1'
	option enable_bridge '0'
	option staticnetmask '255.255.255.0'

