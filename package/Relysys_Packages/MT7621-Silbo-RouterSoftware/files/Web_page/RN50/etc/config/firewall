
config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'REJECT'
	option forward 'REJECT'

config rule 'ipsec_rule1'
	option name 'Allow-IKE-input'
	option src 'EWAN1'
	option proto 'udp'
	option dest_port '500'
	option target 'ACCEPT'

config rule 'ipsec_rule2'
	option name 'Allow-IKE-input'
	option src 'EWAN1'
	option proto 'udp'
	option dest_port '4500'
	option target 'ACCEPT'

config rule
	option name 'Allow-IPSec-ESP'
	option src 'EWAN1'
	option dest 'SW_LAN'
	option proto 'esp'
	option target 'ACCEPT'

config include
	option path '/etc/firewall.user'

config zone 'EWAN1'
	option name 'EWAN1'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'EWAN1'
	option masq '1'
	option mtu_fix '1'
	option extra_src '-m policy --dir in --pol none'
	option extra_dest '-m policy --dir out --pol none'

config zone 'wifi'
	option name 'ra0'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'ra0'
	option mtu_fix '1'
	option masq '0'

config zone 'wifi5'
	option name 'rai0'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'rai0'
	option mtu_fix '1'
	option masq '0'

config include 'nodogsplash'
	option type 'script'
	option path '/usr/lib/nodogsplash/restart.sh'

config zone 'SW_LAN'
	option name 'SW_LAN'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'SW_LAN'
	option mtu_fix '1'
	option extra_src '-m policy --dir in --pol none'
	option extra_dest '-m policy --dir out --pol none'
	option masq '0'

config forwarding 'SW_LANEWAN1'
	option src 'SW_LAN'
	option dest 'EWAN1'

config forwarding 'wifiEWAN1'
	option src 'ra0'
	option dest 'EWAN1'

config forwarding 'wifi5EWAN1'
	option src 'rai0'
	option dest 'EWAN1'

