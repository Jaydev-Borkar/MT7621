
config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'REJECT'
	option forward 'REJECT'

config rule 'ipsec_rule1'
	option name 'Allow-IKE-input'
	option src 'EWAN5'
	option proto 'udp'
	option dest_port '500'
	option target 'ACCEPT'

config rule 'ipsec_rule2'
	option name 'Allow-IKE-input'
	option src 'EWAN5'
	option proto 'udp'
	option dest_port '4500'
	option target 'ACCEPT'

config rule
	option name 'Allow-IPSec-ESP'
	option src 'EWAN5'
	option dest 'SW_LAN'
	option proto 'esp'
	option target 'ACCEPT'

config include
	option path '/etc/firewall.user'

config zone 'EWAN5'
	option name 'EWAN5'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'EWAN5'
	option masq '1'
	option mtu_fix '1'
	option extra_src '-m policy --dir in --pol none'
	option extra_dest '-m policy --dir out --pol none'

config zone 'SW_LAN'
	option name 'SW_LAN'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'SW_LAN'
	option masq '1'
	option mtu_fix '1'
	option extra_src '-m policy --dir in --pol none'
	option extra_dest '-m policy --dir out --pol none'

config forwarding 'SW_LANEWAN5'
	option src 'SW_LAN'
	option dest 'EWAN5'
