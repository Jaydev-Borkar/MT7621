
config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'REJECT'
	option forward 'REJECT'
	
config rule 'ipsec_rule1'
	option name 'Allow-IKE-input'
	option src 'EWAN3'
	option proto 'udp'
	option dest_port '500'
	option target 'ACCEPT'

config rule 'ipsec_rule2'
	option name 'Allow-IKE-input'
	option src 'EWAN3'
	option proto 'udp'
	option dest_port '4500'
	option target 'ACCEPT'

config rule
	option name 'Allow-IPSec-ESP'
	option src 'EWAN3'
	option dest 'SW_LAN'
	option proto 'esp'
	option target 'ACCEPT'

config include
	option path '/etc/firewall.user'

config zone 'wifi'
	option name 'ra0'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'ra0'
	option masq '1'
	option mtu_fix '1'

config zone 'SW_LAN'
	option name 'SW_LAN'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'SW_LAN'
	option masq '1'
	option mtu_fix '1'
	option extra_src '-m policy --dir in --pol none'
	option extra_dest '-m policy --dir out --pol none'

config zone 'ewan3'
	option name 'EWAN3'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'EWAN3'
	option masq '1'
	option mtu_fix '1'
	option input 'ACCEPT'
	option extra_src '-m policy --dir in --pol none'
	option extra_dest '-m policy --dir out --pol none'

config forwarding 'swlanewan3'
	option src 'SW_LAN'
	option dest 'EWAN3'

config zone 'wifi5'
	option name 'rai0'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'rai0'
	option masq '1'
	option mtu_fix '1'

config zone 'cwan1_0'
	option name 'CWAN1_0'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'CWAN1_0'
	option masq '1'
	option mtu_fix '1'
	option extra_src '-m policy --dir in --pol none'
	option extra_dest '-m policy --dir out --pol none'

config forwarding 'swlancwan1_0'
	option src 'SW_LAN'
	option dest 'CWAN1_0'

config forwarding 'swlancwan1_1'
	option src 'SW_LAN'
	option dest 'CWAN1_1'

config forwarding 'wifiewan3'
	option src 'ra0'
	option dest 'EWAN3'

config forwarding 'wifi5ewan3'
	option src 'rai0'
	option dest 'EWAN3'

config forwarding 'wificwan1_0'
	option src 'ra0'
	option dest 'CWAN1_0'

config forwarding 'wificwan1_1'
	option src 'ra0'
	option dest 'CWAN1_1'

config forwarding 'wifi5cwan1_0'
	option src 'rai0'
	option dest 'CWAN1_0'

config forwarding 'wifi5cwan1_1'
	option src 'rai0'
	option dest 'CWAN1_1'

config zone 'cwan1_1'
	option name 'CWAN1_1'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option network 'CWAN1_1'
	option masq '1'
	option mtu_fix '1'
	option extra_src '-m policy --dir in --pol none'
	option extra_dest '-m policy --dir out --pol none'

# Allow DHCPv6 replies                                                     
config rule 'udp_DHCPv6_replies'                        
        option target 'ACCEPT'        
        option src 'CWAN1_0'     
        option proto 'udp'       
        option dest_port '546'
        option name 'Allow DHCPv6 replies'
        option family 'ipv6'       
        option src_port '547'
