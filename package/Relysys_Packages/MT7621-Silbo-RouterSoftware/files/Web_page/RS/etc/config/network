
config interface 'loopback'
	option ifname 'lo'
	option proto 'static'
	option ip_int_instance '1'

config globals 'globals'
	option ula_prefix 'fd6a:615d:04a6::/48'
	option packet_steering '1'

config switch
	option name 'switch0'
	option reset '1'
	option enable_vlan '1'

config interface 'EWAN3'
	option ifname 'eth0.3'
	option proto 'dhcp'
	option metric '5'
	option ip_int_instance '2'
	option gateway '10.1.1.1'

config interface 'ra0'
	option netmask '255.255.255.0'
	option ipaddr '192.168.100.1'
	option proto 'static'
	option ifname 'ra0'

config interface 'rai0'
	option netmask '255.255.255.0'
	option ipaddr '192.168.200.1'
	option proto 'static'
	option ifname 'wlan0'

config switch_vlan 'lan3'
	option device 'switch0'
	option vlan '3'
	option ports '2 6t'

config interface 'SW_LAN'
	option ifname 'eth0.1'
	option proto 'static'
	option ipaddr '192.168.10.1'
	option netmask '255.255.255.0'
	list dns '8.8.8.8'

config switch_vlan 'swlan'
	option device 'switch0'
	option vlan '1'
	option ports '0 1   6t'

config interface 'CWAN1_0'
	option ifname 'usb0'
	option proto 'dhcp'
	option metric '8'

