
config globals 'globals'
	option enabled '1'
	option mmx_mask '0x3F00'
	option rtmon_interval '5'

config rule 'default_rule_v6'
	option dest_ip '::/0'
	option family 'ipv6'
	option use_policy 'failover_v6'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option family 'ipv4'
	option use_policy 'failover_v4'

config policy 'failover_v4'
	option last_resort 'default'
	list use_member 'EWAN5_member'
	list use_member 'CWAN1_0_member'
	list use_member 'CWAN1_1_member'

config interface 'EWAN5'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '8.8.4.4'
	option track_method 'ping'
	option family 'ipv4'
	option reliability '1'
	option count '1'
	option timeout '2'
	option down '3'
	option up '3'
	list flush_conntrack 'ifup'
	list flush_conntrack 'ifdown'
	list flush_conntrack 'connected'
	list flush_conntrack 'disconnected'

config member 'EWAN5_member'
	option interface 'EWAN5'
	option metric '5'

config interface 'CWAN1_0'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '8.8.4.4'
	option track_method 'ping'
	option family 'ipv4'
	option reliability '1'
	option count '1'
	option timeout '2'
	option down '3'
	option up '3'
	list flush_conntrack 'ifup'
	list flush_conntrack 'ifdown'
	list flush_conntrack 'connected'
	list flush_conntrack 'disconnected'

config member 'CWAN1_0_member'
	option interface 'CWAN1_0'
	option metric '8'

config interface 'CWAN1_1'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '8.8.4.4'
	option track_method 'ping'
	option family 'ipv4'
	option reliability '1'
	option count '1'
	option timeout '2'
	option down '3'
	option up '3'
	list flush_conntrack 'ifup'
	list flush_conntrack 'ifdown'
	list flush_conntrack 'connected'
	list flush_conntrack 'disconnected'

config member 'CWAN1_1_member'
	option interface 'CWAN1_1'
	option metric '9'

