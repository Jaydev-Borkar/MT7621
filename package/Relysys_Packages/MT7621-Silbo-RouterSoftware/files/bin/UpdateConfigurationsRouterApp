	   echo "failureaction=\"$failureaction\""
	   echo "noofretries=\"$noofretries\""

   } > "${RouterApplocalconfigureCfgPath2}.cfg"
  
}


RouterApplocalCronUpdateModem1()
{
	echo "Updating Router Local Ping App configuration "
    echo "Updating crontab Router Application configuration"
    config_load "$RouterEventfile"
    
    config_get  enablerouterlocalpingapp                "$routerlocalconfigureEventSection1"    enablerouterlocalpingapp
    config_get  timeintervalforpingcheck                "$routerlocalconfigureEventSection1"    timeintervalforpingcheck
    timeintervalforpingcheckval=$(echo "$timeintervalforpingcheck" | sed s'/,$//')

    # add entry to cron file
     if [ "$enablerouterlocalpingapp" =  "1" ]
    then
	    sed -i '/Modem1RouterlocalPingApp.sh/d' /etc/crontabs/root
	   echo "*/$timeintervalforpingcheckval * * * * /bin/Modem1RouterlocalPingApp.sh" >> /etc/crontabs/root
	else
	    sed -i '/Modem1RouterlocalPingApp.sh/d' /etc/crontabs/root
    fi
    
    /etc/init.d/cron restart
    sleep 2
    
	
}

RouterApplocalCronUpdateModem2()
{
	echo "Updating Router Local Ping App configuration "
    echo "Updating crontab Router Application configuration"
    config_load "$RouterEventfile"
    
    config_get  enablerouterlocalpingapp                "$routerlocalconfigureEventSection2"    enablerouterlocalpingapp
    config_get  timeintervalforpingcheck                "$routerlocalconfigureEventSection2"    timeintervalforpingcheck
    timeintervalforpingcheckval=$(echo "$timeintervalforpingcheck" | sed s'/,$//')

    # add entry to cron file
     if [ "$enablerouterlocalpingapp" =  "1" ]
