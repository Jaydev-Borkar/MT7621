#Check for quectel modems.
noofmodem=$(lsusb | grep -c "2c7c")

ReadSystemConfigFile
ReadSystemGpioFile

date=$(date)

if [ "$EnableCellular" != "1" ]
then
	exit 0
fi

#Delete all the CWANs during hotplug and recreate them.
uci delete network.CWAN1 > /dev/null 2>&1
uci delete network.CWAN1_0 > /dev/null 2>&1
uci delete network.CWAN1_1 > /dev/null 2>&1
uci delete network.wan6c1 > /dev/null 2>&1

uci commit network

#Checking if it's single/dual modem. Works for both xhci and usb.
#Using grep on dmesg brings a lot of uncertainity, so it's easier to use lsusb to determine the number of modems.
#noofmodem=$(dmesg | grep -c "usb-1e1c0000.*")

#Check for quectel modems.
#noofmodem=$(lsusb | grep -c "2c7c")

uci set systemgpio.gpio.noofmodem=$noofmodem

#dualmodule
#if [ $noofmodem = "2" ]
if [ "$CellularOperationModelocal" = "dualcellularsinglesim" ]
then
	cellularmodule="dualmodule"
	echo $cellularmodule > /tmp/cellularmodule.txt
	
	echo "========================================================" >> $Logfile1
	echo " " >> $Logfile1
	echo "---------<23-CWAN-ADD>----------" >> $Logfile1
	echo "<23-CWAN-ADD> Modems=$cellularmodule" >> $Logfile1
	echo "<23-CWAN-ADD> CellularOperationMode=$CellularOperationModelocal" >> $Logfile1
	
	# Since it is dual module, extract the product IDs of both the modems.
	idProduct=$(lsusb | grep "ID 2c7c" | awk '{print $6}' | cut -d ":" -f 2)
	productId1=$(echo "$idProduct" | head -1)
	productId2=$(echo "$idProduct" | tail -1)

	#Find all files named idProduct under /sys/bus/usb/devices/*/, & search for the value of <idProduct_value> within each file,
	#and outputs the file path(s) without the idProduct suffix.
	#Ex- 
	#/sys/bus/usb/devices/2-1
	#/sys/bus/usb/devices/usb2/2-1
	#Hence, we use head -1 to get - /sys/bus/usb/devices/2-1
	usb_path1=$(find /sys/bus/usb/devices/*/ -name idProduct -type f -exec grep -l $productId1 {} \; | sed 's|/idProduct$||' | head -1)
	usb_path2=$(find /sys/bus/usb/devices/*/ -name idProduct -type f -exec grep -l $productId2 {} \; | sed 's|/idProduct$||' | head -1)

	#The ${usb_path##*/} expression extracts the characters after the last slash (/) in the string, leaving only devname ("1-1").
	#Ex- 2-1
	devname1="${usb_path1##*/}"
	devname2="${usb_path2##*/}"
	
	#In the 1st hotplug script, use only 1-1 & 2-1 usb-path. Because, if used both then,
	#both the modems get rebooted.
	
	if [ "$devname1" = "1-1" ] || [ "$devname1" = "2-1" ]
	then
		devname=$devname1
		usb_path=$usb_path1
		productId=$productId1
		
	elif [ "$devname2" = "1-1" ] || [ "$devname2" = "2-1" ]
	then
		devname=$devname2
		usb_path=$usb_path2
		productId=$productId2
	fi
	
	echo "<23-CWAN-ADD> The productId is=$productId" >> $Logfile1
	
	#Get path in /sys/devices using readlink
	#Ex- /sys/devices/platform/1e1c0000.xhci/usb2/2-1
	path=$(readlink -f $usb_path)	

	if [ "$devname" = "1-1" ]
	then
		echo "<23-CWAN-ADD> The devname is=$devname" >> $Logfile1
		echo "<23-CWAN-ADD> The interface name is=CWAN1" >> $Logfile1
		uci set modem.CWAN1.usbbuspath=$path
		
		#find the interface name from the usbpath
		#We have to find "net" dir & then "ls" the net dir to get "ifname".
		#Ex-
		#net= /sys/devices/platform/1e1c0000.xhci/usb2/2-1/2-1:1.0/net
		#ifname= usb1
		net=$(find $path -name net -type d)
		ifname=$(ls $net)
		
		uci set modem.CWAN1.ifname=$ifname
		echo "<23-CWAN-ADD> The ifname is=$ifname" >> $Logfile1
		
		#find the device created in /dev if the modem is in qmi mode. That is, cdc-wdm
		#Search for "usbmisc" in the path to find if it is qmi or not.
		#If echo ${#usbmisc} is 0; then, it is cdc-ether.
		#If echo ${#usbmisc} is greater than 0; then, it is qmi.
		#This is to get "/dev/cdc-wdm0"
		usbmisc=$(find $path -name usbmisc -type d)
		if [ ${#usbmisc} -gt 0 ]
		then
			device=$(ls $usbmisc)
			echo "<23-CWAN-ADD> For qmi, the device is=$device" >> $Logfile1
			uci set modem.CWAN1.device=$device
		fi
		
		#Add either CWAN1/CWAN2. Don't add both.
		uci set modem.CWAN1_0.modemenable=0
		uci set modem.CWAN1_1.modemenable=0
		uci set modem.CWAN1.modemenable=1
		uci commit modem

		echo "<23-CWAN-ADD> modem.CWAN1.modemenable=1" >> $Logfile1
		
		prefix="CWAN1_"
		CWAN1_0_Symlink
		CWAN1_1_Symlink
		
		#/sys/devices/platform/1e1c0000.usb/usb1/1-1/1-1:1.0/ttyUSB0/tty/ttyUSB0 ... We get ttyUSB0 from here.
		#devname=$(find $path1 -name ttyUSB* -path "$DEVPATH/*" | cut -d '/' -f 11)
		
		#SYMLINK="${prefix}$(echo -n ${devname} | tail -c 1)"
		#ln -s /dev/${DEVNAME} /dev/${SYMLINK}
		
		#Create/delete Symlink 
		Create_Delete_Symlink $path $prefix $ACTION
		
		if [ "$productId" = "0125" ]
		then
			echo "<23-CWAN-ADD> EC25E CWAN1" >> $Logfile1
			EC25E CWAN1
	
		elif [ "$productId" = "6005" ]
		then
			echo "<23-CWAN-ADD> EC200A CWAN1" >> $Logfile1
			EC200A CWAN1
			
		elif [ "$productId" = "0306" ]
		then
			echo "<23-CWAN-ADD> EM06 CWAN1" >> $Logfile1
			EM06 CWAN1

		elif [ "$productId" = "030e" ]
		then
			echo "<23-CWAN-ADD> EM05G CWAN1" >> $Logfile1
			EM05G CWAN1
		fi

	elif [ "$devname" = "2-1" ]
	then
		echo "<23-CWAN-ADD> The devname is=$devname" >> $Logfile1
		echo "<23-CWAN-ADD> The interface name is=CWAN1" >> $Logfile1
		uci set modem.CWAN1.usbbuspath=$path
		
		#find the interface name from the usbpath
		net=$(find $path -name net -type d)
		ifname=$(ls $net)
		
		uci set modem.CWAN1.ifname=$ifname
		echo "<23-CWAN-ADD> The ifname is=$ifname" >> $Logfile1
		
		#find the device created in /dev if the modem is in qmi mode. That is, cdc-wdm
		usbmisc=$(find $path -name usbmisc -type d)
		if [ ${#usbmisc} -gt 0 ]
		then
			device=$(ls $usbmisc)
			echo "<23-CWAN-ADD> For qmi, the device is=$device" >> $Logfile1
			uci set modem.CWAN1.device=$device
		fi
		
		#Add either CWAN1/CWAN2. Don't add both.
