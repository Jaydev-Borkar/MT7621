CWAN1_Symlink(){
	prefixlocal="CWAN1_"
	SYMLINKLOCAL="${prefixlocal}$(echo -n ${DEVNAME} | tail -c 1)"
	rm /dev/${SYMLINKLOCAL}
}

CWAN2_Symlink(){
	prefixlocal="CWAN2_"
	SYMLINKLOCAL="${prefixlocal}$(echo -n ${DEVNAME} | tail -c 1)"
	rm /dev/${SYMLINKLOCAL}
}

