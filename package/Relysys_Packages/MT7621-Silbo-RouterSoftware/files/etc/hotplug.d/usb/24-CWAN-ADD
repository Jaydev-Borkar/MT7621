	fi

	uci set modem.$1.manufacturer=$Manufacturer	
	uci set modem.$1.model=$model	
	uci set modem.$1.productid=$productId	
	uci set modem.$1.vendorid=$vendorId	
	uci set modem.$1.protocol=$protocol	
	uci set modem.$1.comport=$comport
	uci set modem.$1.altcomport=$altcomport
	uci set modem.$1.smsport=$comport	
	uci set sysconfig.sysconfig.cellularmodem$a=$cellularmodem	
	uci set sysconfig.bandlock.cellularmodem$a=$cellularmodem	
	uci set sysconfig.sysconfig.Manufacturer$a=$Manufacturer	
	uci set sysconfig.sysconfig.model$a=$model	
	uci set sysconfig.sysconfig.vendorid$a=$vendorId	
	uci set sysconfig.sysconfig.productid$a=$productId	
	uci set sysconfig.sysconfig.protocol$a=$protocol	
	uci set sysconfig.sysconfig.comport$a=$comport	
	uci set sysconfig.sysconfig.altcomport$a=$altcomport	
	uci set sysconfig.sysconfig.smsport$a=$comport
	
	uci commit systemgpio
	uci commit modem
	uci commit sysconfig
	
	if [ "${ACTION}" = "add" ]
	then
		echo "<24-CWAN-ADD> <EC25E> AddInterface_mod2.sh $1" >> $Logfile2
		
		#Setting AddIfaceRunningstatus2 to 0. That is, allow AddInterface to run.
		echo "AddIfaceRunningstatus2=0" > /tmp/AddIfaceRunningstatus2
		
