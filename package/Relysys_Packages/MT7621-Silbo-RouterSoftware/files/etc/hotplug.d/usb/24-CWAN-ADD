#Check for quectel modems.
noofmodem=$(lsusb | grep -c "2c7c")

ReadSystemConfigFile
ReadSystemGpioFile

date=$(date)

if [ "$EnableCellular" != "1" ]
then
	exit 0
fi

#Delete all the CWANs during hotplug and recreate them.
uci delete network.CWAN2 > /dev/null 2>&1
uci delete network.CWAN1_0 > /dev/null 2>&1
uci delete network.CWAN1_1 > /dev/null 2>&1
uci delete network.wan6c2 > /dev/null 2>&1

uci commit network

#Checking if it's single/dual modem. Works for both xhci and usb.
#Using grep on dmesg brings a lot of uncertainity, so it's easier to use lsusb to determine the number of modems.
#noofmodem=$(dmesg | grep -c "usb-1e1c0000.*")

#Check for quectel modems.
#noofmodem=$(lsusb | grep -c "2c7c")

uci set systemgpio.gpio.noofmodem=$noofmodem

#dualmodule
#if [ $noofmodem = "2" ]
if [ "$CellularOperationModelocal" = "dualcellularsinglesim" ]
then
	cellularmodule="dualmodule"
	echo $cellularmodule > /tmp/cellularmodule.txt
	
	echo "========================================================" >> $Logfile2
	echo " " >> $Logfile2
	echo "---------<24-CWAN-ADD>----------" >> $Logfile2
	echo "<24-CWAN-ADD> Modems=$cellularmodule" >> $Logfile2
	echo "<24-CWAN-ADD> CellularOperationMode=$CellularOperationModelocal" >> $Logfile2
	
	# Since it is dual module, extract the product IDs of both the modems.
	idProduct=$(lsusb | grep "ID 2c7c" | awk '{print $6}' | cut -d ":" -f 2)
	productId1=$(echo "$idProduct" | head -1)
	productId2=$(echo "$idProduct" | tail -1)
	
	usb_path1=$(find /sys/bus/usb/devices/*/ -name idProduct -type f -exec grep -l $productId1 {} \; | sed 's|/idProduct$||' | grep "1-2" | head -1)
	usb_path2=$(find /sys/bus/usb/devices/*/ -name idProduct -type f -exec grep -l $productId2 {} \; | sed 's|/idProduct$||' | grep "1-2" | head -1)
	
	if [ -n "$usb_path1" ]
	then
		usb_path=$usb_path1
		productId=$productId1
	elif [ -n "$usb_path2" ]
	then
		usb_path=$usb_path2
		productId=$productId2
	fi
	
	#The ${usb_path##*/} expression extracts the characters after the last slash (/) in the string, leaving only devname ("1-1").
	devname="${usb_path##*/}"
	
	echo "<24-CWAN-ADD> devname=$devname" >> $Logfile2
	echo "<24-CWAN-ADD> usb_path=$usb_path" >> $Logfile2
	echo "<24-CWAN-ADD> productId=$productId" >> $Logfile2
	
	#Get path in /sys/devices using readlink
	path=$(readlink -f $usb_path)	

	if [ "$devname" = "1-2" ]
	then
		echo "<24-CWAN-ADD> The devname is=$devname" >> $Logfile2
		echo "<24-CWAN-ADD> The interface name is=CWAN2" >> $Logfile2
		uci set modem.CWAN2.usbbuspath=$path
		
		#find the interface name from the usbpath
		net=$(find $path -name net -type d)
		ifname=$(ls $net)
		
		uci set modem.CWAN2.ifname=$ifname
		echo "<24-CWAN-ADD> The ifname is=$ifname" >> $Logfile2
		
		#find the device created in /dev if the modem is in qmi mode. That is, cdc-wdm
		usbmisc=$(find $path -name usbmisc -type d)
		if [ ${#usbmisc} -gt 0 ]
		then
			device=$(ls $usbmisc)
			echo "<24-CWAN-ADD> For qmi, the device is=$device" >> $Logfile2
			uci set modem.CWAN2.device=$device
		fi
		
		#Add either CWAN1/CWAN2. Don't add both.
		uci set modem.CWAN1_0.modemenable=0
		uci set modem.CWAN1_1.modemenable=0
		uci set modem.CWAN2.modemenable=1
		uci commit modem

		echo "<24-CWAN-ADD> modem.CWAN2.modemenable=1" >> $Logfile2		
		
		prefix="CWAN2_"
		CWAN1_0_Symlink
		CWAN1_1_Symlink
		
		#/sys/devices/platform/1e1c0000.usb/usb1/1-1/1-1:1.0/ttyUSB0/tty/ttyUSB0 ... We get ttyUSB0 from here.
		#devname=$(find $path1 -name ttyUSB* -path "$DEVPATH/*" | cut -d '/' -f 11)
		
		#SYMLINK="${prefix}$(echo -n ${devname} | tail -c 1)"
		#ln -s /dev/${DEVNAME} /dev/${SYMLINK}
		
		#Create/delete Symlink 
		Create_Delete_Symlink $path $prefix $ACTION
		
		if [ "$productId" = "0125" ]
		then
			echo "<24-CWAN-ADD> EC25E CWAN2" >> $Logfile2
			EC25E CWAN2
	
		elif [ "$productId" = "6005" ]
		then
			echo "<24-CWAN-ADD> EC200A CWAN2" >> $Logfile2
			EC200A CWAN2
			
		elif [ "$productId" = "0306" ]
		then
			echo "<24-CWAN-ADD> EM06 CWAN2" >> $Logfile2
			EM06 CWAN2
			
		elif [ "$productId" = "030e" ]
		then
			echo "<24-CWAN-ADD> EM05G CWAN2" >> $Logfile2
			EM05G CWAN2
		fi
	fi
fi	
