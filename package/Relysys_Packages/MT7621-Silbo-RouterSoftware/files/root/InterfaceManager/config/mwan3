
config globals 'globals'
	option mmx_mask '0x3F00'
	option rtmon_interval '5'

config rule 'default_rule'
	option dest_ip '0.0.0.0/0'
	option use_policy 'balanced'

config member 'ewan2_m10_w1'
	option interface 'EWAN2'
	option metric '4'
	option weight '4'

config member 'cwan1sim1_m10_w1'
	option interface 'CWAN1_0'
	option metric '2'
	option weight '2'

config member 'cwan1sim2_m10_w1'
	option interface 'CWAN1_1'
	option metric '3'
	option weight '3'

config member 'wifiwan_m10_w1'
	option interface 'apcli0'
	option metric '1'
	option weight '1'

config policy 'balanced'
	list use_member 'ewan2_m10_w1'
	list use_member 'cwan1sim1_m10_w1'
	list use_member 'cwan1sim2_m10_w1'
	list use_member 'wifiwan_m10_w1'

config interface 'EWAN2'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '8.8.4.4'
	list track_ip '208.67.220.220'
	list track_ip '208.67.222.222'
	option family 'ipv4'
	option reliability '2'
	option count '5'
	option timeout '2'
	option failure_latency '1000'
	option recovery_latency '500'
	option failure_loss '30'
	option recovery_loss '5'
	option interval '3'
	option down '3'
	option up '5'

config policy 'ewan2_only'
	list use_member 'ewan2_m10_w1'
	option last_resort 'default'

config interface 'CWAN1_0'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '8.8.4.4'
	list track_ip '208.67.220.220'
	list track_ip '208.67.222.222'
	option family 'ipv4'
	option reliability '3'
	option count '3'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '5'

config interface 'CWAN1_1'
	option enabled '1'
	list track_ip '8.8.8.8'
	list track_ip '8.8.4.4'
	list track_ip '208.67.220.220'
	list track_ip '208.67.222.222'
	option family 'ipv4'
	option reliability '3'
	option count '3'
	option timeout '2'
	option interval '5'
	option down '3'
	option up '5'

config policy 'cwan1sim1_only'
	list use_member 'cwan1sim1_m10_w1'
	option last_resort 'default'

config policy 'cwan1sim2_only'
	list use_member 'cwan1sim2_m10_w1'
	option last_resort 'default'

config policy 'wifiwan_only'
	list use_member 'wifiwan_m10_w1'
	option last_resort 'default'

