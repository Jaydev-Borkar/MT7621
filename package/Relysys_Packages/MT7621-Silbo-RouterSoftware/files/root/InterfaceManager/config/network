
config interface 'loopback'
	option ifname 'lo'
	option proto 'static'

config globals 'globals'
	option ula_prefix 'fd6a:615d:04a6::/48'

config switch
	option name 'switch0'
	option reset '1'
	option enable_vlan '1'

config switch_vlan 'lan5'
	option device 'switch0'
	option vlan '5'
	option ports '4 6t'

config interface 'EWAN5'
	option ifname 'eth0.5'
	option proto 'dhcp'
	option metric '5'
	option gateway '192.168.1.1'

config switch_vlan 'swlan'
	option device 'switch0'
	option vlan '1'
	option ports '0 1 2 3  6t'

config interface 'SW_LAN'
	option ifname 'eth0.1'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	list dns '8.8.8.8'

config interface 'ra0'
	option netmask '255.255.255.0'
	option ipaddr '192.168.12.1'
	option proto 'static'
	option ifname 'wlan0'

config interface 'rai0'
	option netmask '255.255.255.0'
	option ipaddr '192.168.13.1'
	option proto 'static'
	option ifname 'wlan1'

config interface 'CWAN1_0'
	option ifname 'usb0'
	option proto 'dhcp'
	option metric '8'

