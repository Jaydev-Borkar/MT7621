
config system 'system'
	option hostname 'Silbo'
	option ttylogin '1'
	option urandom_seed '0'
	option zonename 'Asia/Kolkata'
	option timezone 'IST-5:30'
	option log_size '32'
	option conloglevel '8'
	option cronloglevel '5'
	option enablegps '0'
	option enablewifi '1'
	option ipkname 'Invendis'
	option model 'R310-5E-2S-2W2-0G-2L'
	option os 'Linux'
	option soc 'Mediatek'
	option log_ip '10.1.1.132'
	option log_port '52333'


config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'

config led 'led_wifi'
	option name 'wifi'
	option sysfs 'linkit-smart-7688:orange:wifi'
	option trigger 'phy0tpt'

config led 'led_lan1'
	option name 'lan1'
	option sysfs 'u7628-01:green:lan1'
	option trigger 'switch0'
	option port_mask '0x2'

config led 'led_lan2'
	option name 'lan2'
	option sysfs 'u7628-01:green:lan2'
	option trigger 'switch0'
	option port_mask '0x4'

config led 'led_lan3'
	option name 'lan3'
	option sysfs 'u7628-01:green:lan3'
	option trigger 'switch0'
	option port_mask '0x8'

config led 'led_lan4'
	option name 'lan4'
	option sysfs 'u7628-01:green:lan4'
	option trigger 'switch0'
	option port_mask '0x10'

config led 'led_wan'
	option name 'wan'
	option sysfs 'u7628-01:green:wan'
	option trigger 'switch0'
	option port_mask '0x01'

